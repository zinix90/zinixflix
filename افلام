<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zinixflix | اكتشف عالم الأفلام</title>
    <!-- تضمين Tailwind CSS للتصميم السريع والمتجاوب -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* تخصيص شريط التمرير والتأثيرات الإضافية */
        body { background-color: #141414; color: #ffffff; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #141414; }
        ::-webkit-scrollbar-thumb { background: #e50914; border-radius: 4px; }
        .movie-card:hover .movie-overlay { opacity: 1; }
    </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col">

    <!-- شريط التنقل (Header) -->
    <header class="bg-black/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-800 shadow-lg">
        <div class="container mx-auto px-4 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="text-3xl font-black text-red-600 tracking-wider">
                ZINIX<span class="text-white">FLIX</span>
            </div>
            <div class="w-full md:w-1/2 relative">
                <input 
                    type="text" 
                    id="searchInput" 
                    placeholder="ابحث عن فيلم، مسلسل..." 
                    class="w-full bg-gray-900 border border-gray-700 text-white px-5 py-3 rounded-full focus:outline-none focus:border-red-600 transition shadow-inner"
                >
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي (Main Content) -->
    <main class="flex-grow container mx-auto px-4 py-8">
        
        <!-- قسم رسائل النظام والتحميل -->
        <div id="statusMessage" class="text-center text-gray-400 my-8 text-lg font-semibold">
            ابدأ البحث لاكتشاف أحدث الأفلام والمسلسلات...
        </div>

        <!-- شبكة عرض الأفلام -->
        <div id="moviesGrid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
            <!-- سيتم حقن كروت الأفلام هنا بواسطة JavaScript -->
        </div>

    </main>

    <!-- تذييل الصفحة (Footer) -->
    <footer class="bg-black py-6 text-center text-gray-500 text-sm mt-auto border-t border-gray-800">
        <p>&copy; 2026 Zinixflix. جميع الحقوق محفوظة.</p>
    </footer>

    <!-- المنطق البرمجي (JavaScript) -->
    <script>
        // ضع مفتاح OMDb API الخاص بك هنا
        const API_KEY = 'http://www.omdbapi.com/?i=tt3896198&apikey=f65d6f49'; 
        
        const searchInput = document.getElementById('searchInput');
        const moviesGrid = document.getElementById('moviesGrid');
        const statusMessage = document.getElementById('statusMessage');
        let debounceTimer;

        // دالة لجلب البيانات من OMDb API
        async function fetchMovies(query) {
            if (!query) {
                moviesGrid.innerHTML = '';
                statusMessage.innerHTML = 'ابدأ البحث لاكتشاف أحدث الأفلام والمسلسلات...';
                statusMessage.style.display = 'block';
                return;
            }

            statusMessage.innerHTML = '<span class="animate-pulse">جاري البحث...</span>';
            statusMessage.style.display = 'block';
            moviesGrid.innerHTML = '';

            try {
                const response = await fetch(`https://www.omdbapi.com/?s=${encodeURIComponent(query)}&apikey=${API_KEY}`);
                const data = await response.json();

                if (data.Response === "True") {
                    statusMessage.style.display = 'none';
                    displayMovies(data.Search);
                } else {
                    statusMessage.innerHTML = `عذراً، ${data.Error === 'Movie not found!' ? 'لم يتم العثور على أفلام مطابقة.' : data.Error}`;
                }
            } catch (error) {
                statusMessage.innerHTML = 'حدث خطأ في الاتصال بالخادم. يرجى المحاولة لاحقاً.';
                console.error("API Fetch Error:", error);
            }
        }

        // دالة لعرض الأفلام في الشبكة
        function displayMovies(movies) {
            moviesGrid.innerHTML = movies.map(movie => {
                // معالجة الصور المفقودة
                const poster = movie.Poster !== "N/A" ? movie.Poster : 'https://via.placeholder.com/300x450/1f2937/ffffff?text=لا+توجد+صورة';
                
                return `
                    <div class="movie-card relative group rounded-xl overflow-hidden shadow-lg bg-gray-800 cursor-pointer transform transition duration-300 hover:scale-105 hover:shadow-red-900/50 hover:shadow-2xl">
                        <img src="${poster}" alt="${movie.Title}" class="w-full h-[350px] object-cover" loading="lazy">
                        
                        <!-- طبقة داكنة تظهر عند التمرير (Overlay) -->
                        <div class="movie-overlay absolute inset-0 bg-gradient-to-t from-black via-black/80 to-transparent opacity-0 transition duration-300 flex flex-col justify-end p-4">
                            <h3 class="text-lg font-bold text-white mb-1 line-clamp-2">${movie.Title}</h3>
                            <div class="flex items-center justify-between text-sm text-gray-300">
                                <span class="bg-red-600 text-white px-2 py-1 rounded font-semibold">${movie.Year}</span>
                                <span class="uppercase tracking-wider border border-gray-500 px-2 py-1 rounded">${movie.Type}</span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // استخدام تقنية Debounce للبحث
        searchInput.addEventListener('input', (e) => {
            clearTimeout(debounceTimer);
            const query = e.target.value.trim();
            // تأخير الطلب بمقدار 500 ملي ثانية بعد آخر نقرة
            debounceTimer = setTimeout(() => {
                fetchMovies(query);
            }, 500);
        });
    </script>
</body>
</html>
